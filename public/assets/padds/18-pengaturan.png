<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 800" width="100%" height="100%">
  <rect width="1280" height="800" fill="#F8FAFC"/>
  <!-- Sidebar -->
  <rect width="210" height="800" fill="#0F172A"/>
  <g transform="translate(14, 16)">
    <circle cx="16" cy="16" r="14" fill="#0066FF"/>
    <text x="16" y="21" text-anchor="middle" fill="#FFFFFF" font-family="-apple-system, sans-serif" font-size="12" font-weight="bold">S</text>
    <text x="38" y="15" fill="#FFFFFF" font-family="-apple-system, sans-serif" font-size="11" font-weight="700">PADDS SMANSAT</text>
    <text x="38" y="27" fill="#64748B" font-family="-apple-system, sans-serif" font-size="8">Pusat Arsip &amp; Dokumen</text>
  </g>
  <!-- Topbar -->
  <rect x="210" y="0" width="1070" height="52" fill="#FFFFFF"/>
  <line x1="210" y1="52" x2="1280" y2="52" stroke="#E2E8F0" stroke-width="1"/>
  <text x="232" y="26" fill="#0F172A" font-family="-apple-system, sans-serif" font-size="15" font-weight="700">Pengaturan</text>
  <text x="232" y="40" fill="#64748B" font-family="-apple-system, sans-serif" font-size="10">Konfigurasi aplikasi</text>
  <!-- User badge -->
  <g transform="translate(1040, 10)">
    <circle cx="16" cy="16" r="14" fill="#0066FF"/>
    <text x="16" y="20" text-anchor="middle" fill="#FFFFFF" font-family="-apple-system, sans-serif" font-size="10" font-weight="bold">U</text>
    <text x="36" y="14" fill="#0F172A" font-family="-apple-system, sans-serif" font-size="9" font-weight="600">UngmengajarSMAN1...</text>
    <text x="36" y="25" fill="#64748B" font-family="-apple-system, sans-serif" font-size="8" font-weight="700">VIEWER</text>
  </g>
  <!-- Content -->
  <g transform="translate(230, 68)">
    
<rect width="1020" height="380" rx="8" fill="#FFFFFF" stroke="#E2E8F0"/>
<text x="24" y="32" fill="#0F172A" font-family="-apple-system, sans-serif" font-size="14" font-weight="700">Pengaturan Sistem</text>
<text x="24" y="50" fill="#64748B" font-family="-apple-system, sans-serif" font-size="11">Pusat konfigurasi PADDS SMANSAT untuk profil sekolah, tampilan, keamanan, dan lainnya.</text>
<rect x="24" y="66" width="972" height="34" rx="6" fill="#EFF6FF" stroke="#BFDBFE"/>
<text x="40" y="88" fill="#1D4ED8" font-family="-apple-system, sans-serif" font-size="11">Hanya Admin yang dapat menyimpan perubahan pengaturan.</text>
<text x="24" y="130" fill="#0F172A" font-family="-apple-system, sans-serif" font-size="12" font-weight="700">Identitas Sistem</text>
<text x="24" y="160" fill="#64748B" font-family="-apple-system, sans-serif" font-size="11">Nama Aplikasi: PADDS SMANSAT</text>
<text x="24" y="185" fill="#64748B" font-family="-apple-system, sans-serif" font-size="11">Versi Aplikasi: 2.0.0</text>

  </g>
  <!-- Watermark -->
  <g transform="translate(1160, 770)">
    <rect width="105" height="22" rx="4" fill="#18181B"/>
    <text x="8" y="15" fill="#FFFFFF" font-family="-apple-system, sans-serif" font-size="8">Made with <tspan fill="#F43F5E" font-weight="bold">Lovable</tspan></text>
  </g>
</svg>