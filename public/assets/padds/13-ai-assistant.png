<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 800" width="100%" height="100%">
  <rect width="1280" height="800" fill="#F8FAFC"/>
  <!-- Sidebar -->
  <rect width="210" height="800" fill="#0F172A"/>
  <g transform="translate(14, 16)">
    <circle cx="16" cy="16" r="14" fill="#0066FF"/>
    <text x="16" y="21" text-anchor="middle" fill="#FFFFFF" font-family="-apple-system, sans-serif" font-size="12" font-weight="bold">S</text>
    <text x="38" y="15" fill="#FFFFFF" font-family="-apple-system, sans-serif" font-size="11" font-weight="700">PADDS SMANSAT</text>
    <text x="38" y="27" fill="#64748B" font-family="-apple-system, sans-serif" font-size="8">Pusat Arsip &amp; Dokumen</text>
  </g>
  <!-- Topbar -->
  <rect x="210" y="0" width="1070" height="52" fill="#FFFFFF"/>
  <line x1="210" y1="52" x2="1280" y2="52" stroke="#E2E8F0" stroke-width="1"/>
  <text x="232" y="26" fill="#0F172A" font-family="-apple-system, sans-serif" font-size="15" font-weight="700">AI Assistant</text>
  <text x="232" y="40" fill="#64748B" font-family="-apple-system, sans-serif" font-size="10">Asisten cerdas arsip</text>
  <!-- User badge -->
  <g transform="translate(1040, 10)">
    <circle cx="16" cy="16" r="14" fill="#0066FF"/>
    <text x="16" y="20" text-anchor="middle" fill="#FFFFFF" font-family="-apple-system, sans-serif" font-size="10" font-weight="bold">U</text>
    <text x="36" y="14" fill="#0F172A" font-family="-apple-system, sans-serif" font-size="9" font-weight="600">UngmengajarSMAN1...</text>
    <text x="36" y="25" fill="#64748B" font-family="-apple-system, sans-serif" font-size="8" font-weight="700">VIEWER</text>
  </g>
  <!-- Content -->
  <g transform="translate(230, 68)">
    
<rect width="1020" height="420" rx="8" fill="#FFFFFF" stroke="#E2E8F0"/>
<circle cx="510" cy="80" r="30" fill="#EFF6FF"/>
<text x="510" y="86" text-anchor="middle" fill="#0066FF" font-family="-apple-system, sans-serif" font-size="20">🤖</text>
<text x="510" y="140" text-anchor="middle" fill="#0F172A" font-family="-apple-system, sans-serif" font-size="16" font-weight="800">Selamat datang di Asisten PADDS SMANSAT</text>
<text x="510" y="165" text-anchor="middle" fill="#64748B" font-family="-apple-system, sans-serif" font-size="11">Saya siap membantu Anda memahami fungsi setiap modul, cara menggunakan fitur, serta alur kerja pengarsipan.</text>

<g transform="translate(160, 200)">
  <rect width="340" height="40" rx="6" fill="#F8FAFC" stroke="#E2E8F0"/>
  <text x="20" y="24" fill="#334155" font-family="-apple-system, sans-serif" font-size="10">Apa itu PADDS SMANSAT dan manfaatnya?</text>
  <rect x="360" y="0" width="340" height="40" rx="6" fill="#F8FAFC" stroke="#E2E8F0"/>
  <text x="380" y="24" fill="#334155" font-family="-apple-system, sans-serif" font-size="10">Bagaimana cara mengunggah arsip?</text>
  <rect x="0" y="50" width="340" height="40" rx="6" fill="#F8FAFC" stroke="#E2E8F0"/>
  <text x="20" y="74" fill="#334155" font-family="-apple-system, sans-serif" font-size="10">Apa fungsi modul Retensi pada PADDS SMANSAT?</text>
  <rect x="360" y="50" width="340" height="40" rx="6" fill="#F8FAFC" stroke="#E2E8F0"/>
  <text x="380" y="74" fill="#334155" font-family="-apple-system, sans-serif" font-size="10">Bagaimana cara membuat dan menggunakan QR?</text>
</g>

  </g>
  <!-- Watermark -->
  <g transform="translate(1160, 770)">
    <rect width="105" height="22" rx="4" fill="#18181B"/>
    <text x="8" y="15" fill="#FFFFFF" font-family="-apple-system, sans-serif" font-size="8">Made with <tspan fill="#F43F5E" font-weight="bold">Lovable</tspan></text>
  </g>
</svg>