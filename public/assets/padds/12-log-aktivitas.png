<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 800" width="100%" height="100%">
  <rect width="1280" height="800" fill="#F8FAFC"/>
  <!-- Sidebar -->
  <rect width="210" height="800" fill="#0F172A"/>
  <g transform="translate(14, 16)">
    <circle cx="16" cy="16" r="14" fill="#0066FF"/>
    <text x="16" y="21" text-anchor="middle" fill="#FFFFFF" font-family="-apple-system, sans-serif" font-size="12" font-weight="bold">S</text>
    <text x="38" y="15" fill="#FFFFFF" font-family="-apple-system, sans-serif" font-size="11" font-weight="700">PADDS SMANSAT</text>
    <text x="38" y="27" fill="#64748B" font-family="-apple-system, sans-serif" font-size="8">Pusat Arsip &amp; Dokumen</text>
  </g>
  <!-- Topbar -->
  <rect x="210" y="0" width="1070" height="52" fill="#FFFFFF"/>
  <line x1="210" y1="52" x2="1280" y2="52" stroke="#E2E8F0" stroke-width="1"/>
  <text x="232" y="26" fill="#0F172A" font-family="-apple-system, sans-serif" font-size="15" font-weight="700">Log Aktivitas</text>
  <text x="232" y="40" fill="#64748B" font-family="-apple-system, sans-serif" font-size="10">Riwayat aktivitas sistem</text>
  <!-- User badge -->
  <g transform="translate(1040, 10)">
    <circle cx="16" cy="16" r="14" fill="#0066FF"/>
    <text x="16" y="20" text-anchor="middle" fill="#FFFFFF" font-family="-apple-system, sans-serif" font-size="10" font-weight="bold">U</text>
    <text x="36" y="14" fill="#0F172A" font-family="-apple-system, sans-serif" font-size="9" font-weight="600">UngmengajarSMAN1...</text>
    <text x="36" y="25" fill="#64748B" font-family="-apple-system, sans-serif" font-size="8" font-weight="700">VIEWER</text>
  </g>
  <!-- Content -->
  <g transform="translate(230, 68)">
    
<g transform="translate(0, 0)">
  <rect width="1020" height="90" rx="8" fill="#FFFFFF" stroke="#E2E8F0"/>
  <text x="24" y="32" fill="#0F172A" font-family="-apple-system, sans-serif" font-size="13" font-weight="700">Log Aktivitas — 4 aktivitas tercatat</text>
  <text x="24" y="55" fill="#64748B" font-family="-apple-system, sans-serif" font-size="11">Total Aktivitas: 4 | Login: 2 | Upload: 0 | Edit: 0 | Hapus: 0</text>
</g>
<g transform="translate(0, 110)">
  <rect width="1020" height="280" rx="8" fill="#FFFFFF" stroke="#E2E8F0"/>
  <text x="24" y="32" fill="#0F172A" font-family="-apple-system, sans-serif" font-size="13" font-weight="700">Aktivitas Terkini</text>
  <line x1="0" y1="50" x2="1020" y2="50" stroke="#E2E8F0"/>
  <text x="24" y="80" fill="#0066FF" font-family="-apple-system, sans-serif" font-size="11" font-weight="700">[Login]</text>
  <text x="90" y="80" fill="#0F172A" font-family="-apple-system, sans-serif" font-size="11">Login berhasil via google — UngmengajarSMAN1Suwawa Timur</text>
  <text x="750" y="80" fill="#64748B" font-family="-apple-system, sans-serif" font-size="11">31 Jul 2026, 12:32</text>
  <line x1="0" y1="106" x2="1020" y2="106" stroke="#E2E8F0"/>
  <text x="24" y="136" fill="#8B5CF6" font-family="-apple-system, sans-serif" font-size="11" font-weight="700">[Lihat]</text>
  <text x="90" y="136" fill="#0F172A" font-family="-apple-system, sans-serif" font-size="11">Percakapan AI Assistant — UngmengajarSMAN1Suwawa Timur</text>
  <text x="750" y="136" fill="#64748B" font-family="-apple-system, sans-serif" font-size="11">31 Jul 2026, 12:30</text>
</g>

  </g>
  <!-- Watermark -->
  <g transform="translate(1160, 770)">
    <rect width="105" height="22" rx="4" fill="#18181B"/>
    <text x="8" y="15" fill="#FFFFFF" font-family="-apple-system, sans-serif" font-size="8">Made with <tspan fill="#F43F5E" font-weight="bold">Lovable</tspan></text>
  </g>
</svg>